# Optional. Only needed for git_clone/git_push over HTTPS against a private repo.
# Leave unset if your remotes already authenticate over SSH.
GITHUB_TOKEN=

# Optional. Every repo_dir/target_dir argument must resolve under this directory -- the server
# refuses to touch anything outside it. Defaults to a workdir/ folder next to server.py.
OPSBUDDY_MCP_WORKDIR=

# Optional. Kills any single git/lint/pytest subprocess that runs longer than this. Default 300.
OPSBUDDY_MCP_TIMEOUT_SECONDS=

# Optional -- only needed for get_repo_mapping/get_job_run/get_latest_failed_run/trigger_job_run.
# Every other tool in this server works with neither of these set at all.
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# Optional -- only read by trigger_job_run, and only when its force=true isn't passed. Comma-
# separated Databricks job IDs safe to auto-re-run without a fresh human approval each time, or
# "all" to allow any (use "all" only in a sandbox/non-production workspace). Leave unset to
# always require force=true (i.e. always require a human's explicit approval per re-run).
OPSBUDDY_VERIFY_ALLOWLIST=

# Optional -- only needed for create_pr/find_open_pr, and only if you're behind a TLS-
# intercepting corporate proxy (e.g. Zscaler). Point this at your proxy's root CA cert file;
# it gets merged with the normal public CA bundle automatically, not used in place of it.
# Confirmed necessary in practice: without this, create_pr/find_open_pr fail outright with
# SSLCertVerificationError on a corporate network, even with a correct GITHUB_TOKEN. If
# NODE_EXTRA_CA_CERTS is already set for another MCP server on this machine (e.g. the official
# "github" server), this reuses that value automatically -- you don't need to set both.
OPSBUDDY_EXTRA_CA_CERT=

# Optional -- only needed for the post_slack_alert tool. Every other tool works without it.
# Simplest option: an incoming webhook. Can only post new top-level messages -- no threading.
SLACK_WEBHOOK_URL=
# Preferred if you want the five opsbuddy-fix checkpoints to post as one thread instead of five
# separate top-level messages: a Slack app's bot token (xoxb-...) invited into the target
# channel, via the Slack Web API's chat.postMessage. Used automatically instead of the webhook
# above whenever both SLACK_BOT_TOKEN and SLACK_CHANNEL_ID are set. api.slack.com/apps -> your
# app -> OAuth & Permissions -> Bot Token Scopes: add chat:write -> install/reinstall the app ->
# copy the Bot User OAuth Token.
SLACK_BOT_TOKEN=
# The channel the bot token posts into -- right-click the channel in Slack -> View channel
# details -> the ID at the bottom (starts with C). Must be a channel the bot has been invited into.
SLACK_CHANNEL_ID=

# Optional -- DATABRICKS_SQL_WAREHOUSE_ID powers both log_incident and get_table_lineage; every
# other tool works with both unset. It's a resource ID, not a credential -- reuse the same value
# already configured for the databricks-lineage plugin's DATABRICKS_SQL_WAREHOUSE_ID, if one is
# registered, rather than looking up a second one. DATABRICKS_OPS_INCIDENT_TABLE (log_incident
# only) defaults to dev.ops_incidents.incident_log if unset. get_table_lineage also needs Unity
# Catalog lineage tracking enabled on the workspace -- not something an env var can turn on.
DATABRICKS_SQL_WAREHOUSE_ID=
DATABRICKS_OPS_INCIDENT_TABLE=

# Optional. "stdio" (default, what Claude Desktop/Code spawn) or "http"/"streamable-http" to run
# as a persistent, network-reachable connector instead.
MCP_TRANSPORT=

# Only used when MCP_TRANSPORT=http.
MCP_HOST=
MCP_PORT=
MCP_API_KEY=
