# Optional. Only needed for git_clone/git_push over HTTPS against a private repo.
# Leave unset if your remotes already authenticate over SSH.
GITHUB_TOKEN=

# Optional. Every repo_dir/target_dir argument must resolve under this directory -- the server
# refuses to touch anything outside it. Defaults to a workdir/ folder next to server.py.
OPSBUDDY_MCP_WORKDIR=

# Optional. Kills any single git/lint/pytest subprocess that runs longer than this. Default 300.
OPSBUDDY_MCP_TIMEOUT_SECONDS=

# Optional -- only needed for the get_repo_mapping tool. Every other tool in this server works
# with neither of these set at all.
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# Optional. "stdio" (default, what Claude Desktop/Code spawn) or "http"/"streamable-http" to run
# as a persistent, network-reachable connector instead.
MCP_TRANSPORT=

# Only used when MCP_TRANSPORT=http.
MCP_HOST=
MCP_PORT=
MCP_API_KEY=
