# Optional. Only needed for git_clone/git_push over HTTPS against a private repo.
# Leave unset if your remotes already authenticate over SSH.
GITHUB_TOKEN=

# Optional. Every repo_dir/target_dir argument must resolve under this directory -- the server
# refuses to touch anything outside it. Defaults to a workdir/ folder next to server.py.
OPSBUDDY_MCP_WORKDIR=

# Optional. Kills any single git/lint/pytest subprocess that runs longer than this. Default 300.
OPSBUDDY_MCP_TIMEOUT_SECONDS=

# Optional -- only needed for the get_repo_mapping tool. Every other tool in this server works
# with neither of these set at all.
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# Optional -- only needed for create_pr/find_open_pr, and only if you're behind a TLS-
# intercepting corporate proxy (e.g. Zscaler). Point this at your proxy's root CA cert file;
# it gets merged with the normal public CA bundle automatically, not used in place of it.
# Confirmed necessary in practice: without this, create_pr/find_open_pr fail outright with
# SSLCertVerificationError on a corporate network, even with a correct GITHUB_TOKEN. If
# NODE_EXTRA_CA_CERTS is already set for another MCP server on this machine (e.g. the official
# "github" server), this reuses that value automatically -- you don't need to set both.
OPSBUDDY_EXTRA_CA_CERT=

# Optional -- only needed for the post_slack_alert tool. Every other tool works without it.
SLACK_WEBHOOK_URL=

# Optional -- only needed for the log_incident tool. Every other tool works with both unset.
# DATABRICKS_SQL_WAREHOUSE_ID is a resource ID, not a credential -- reuse the same value already
# configured for the databricks-lineage plugin's DATABRICKS_SQL_WAREHOUSE_ID, if one is
# registered, rather than looking up a second one. DATABRICKS_OPS_INCIDENT_TABLE defaults to
# dev.ops_incidents.incident_log if unset.
DATABRICKS_SQL_WAREHOUSE_ID=
DATABRICKS_OPS_INCIDENT_TABLE=

# Optional. "stdio" (default, what Claude Desktop/Code spawn) or "http"/"streamable-http" to run
# as a persistent, network-reachable connector instead.
MCP_TRANSPORT=

# Only used when MCP_TRANSPORT=http.
MCP_HOST=
MCP_PORT=
MCP_API_KEY=
