{
  "mcpServers": {
    "opsbuddy-git-ops": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}/mcp-server",
        "server.py"
      ],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}",
        "OPSBUDDY_MCP_WORKDIR": "${OPSBUDDY_MCP_WORKDIR}",
        "DATABRICKS_HOST": "${DATABRICKS_HOST}",
        "DATABRICKS_TOKEN": "${DATABRICKS_TOKEN}",
        "OPSBUDDY_EXTRA_CA_CERT": "${OPSBUDDY_EXTRA_CA_CERT}",
        "NODE_EXTRA_CA_CERTS": "${NODE_EXTRA_CA_CERTS}",
        "SLACK_WEBHOOK_URL": "${SLACK_WEBHOOK_URL}",
        "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}",
        "SLACK_CHANNEL_ID": "${SLACK_CHANNEL_ID}",
        "DATABRICKS_SQL_WAREHOUSE_ID": "${DATABRICKS_SQL_WAREHOUSE_ID}",
        "DATABRICKS_OPS_INCIDENT_TABLE": "${DATABRICKS_OPS_INCIDENT_TABLE}",
        "OPSBUDDY_VERIFY_ALLOWLIST": "${OPSBUDDY_VERIFY_ALLOWLIST}"
      }
    }
  }
}
